{
  "opencollection": "1.0.0",
  "info": {
    "name": "Papaya Global Workforce Payments Authentication API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Obtain Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.papayaglobal.com/api/v1/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Authenticates with API key and client secret to obtain a JWT bearer token valid for 24 hours. Use the token in subsequent requests via the Authorization: Bearer header.\n"
        }
      ]
    }
  ],
  "bundled": true
}