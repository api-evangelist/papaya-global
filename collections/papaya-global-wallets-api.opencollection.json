{
  "opencollection": "1.0.0",
  "info": {
    "name": "Papaya Global Workforce Payments Authentication Wallets API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Wallets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Wallets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.papayaglobal.com/api/v1/payments/wallets",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "Filter by wallet ID"
              },
              {
                "name": "active_only",
                "value": "",
                "type": "query",
                "description": "Return only active wallets"
              },
              {
                "name": "currency",
                "value": "",
                "type": "query",
                "description": "Filter by currency code (ISO 4217)"
              },
              {
                "name": "skip",
                "value": "",
                "type": "query",
                "description": "Number of records to skip for pagination"
              },
              {
                "name": "take",
                "value": "",
                "type": "query",
                "description": "Number of records to return"
              }
            ]
          },
          "docs": "Retrieve a list of organizational wallets with optional filtering."
        },
        {
          "info": {
            "name": "Get Wallet Statement",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.papayaglobal.com/api/v1/payments/wallets/:id/statement",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Wallet ID"
              },
              {
                "name": "start",
                "value": "",
                "type": "query",
                "description": "Start date-time for statement period (YYYY-MM-DDTHH:mm:ssZ)"
              },
              {
                "name": "end",
                "value": "",
                "type": "query",
                "description": "End date-time for statement period (YYYY-MM-DDTHH:mm:ssZ)"
              },
              {
                "name": "skip",
                "value": "",
                "type": "query"
              },
              {
                "name": "take",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve transaction statement for a specific wallet within a date range."
        }
      ]
    }
  ],
  "bundled": true
}